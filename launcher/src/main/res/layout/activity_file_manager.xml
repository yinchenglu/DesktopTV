<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#EE101010"
	android:orientation="vertical">

	<TextView
		android:id="@+id/fm_title"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:paddingLeft="24dp"
		android:paddingTop="16dp"
		android:text="@string/fm_title"
		android:textColor="#ffffffff"
		android:textSize="24sp"/>

	<TextView
		android:id="@+id/fm_path"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:ellipsize="start"
		android:maxLines="1"
		android:paddingLeft="24dp"
		android:paddingRight="24dp"
		android:paddingTop="6dp"
		android:paddingBottom="6dp"
		android:textColor="#FF9E9E9E"
		android:textSize="13sp"/>

	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="#33FFFFFF"/>

	<ListView
		android:id="@+id/fm_list"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:divider="#22FFFFFF"
		android:dividerHeight="1dp"
		android:listSelector="@drawable/hidden_row_selector"
		android:paddingLeft="12dp"
		android:paddingRight="12dp"/>

</LinearLayout>
