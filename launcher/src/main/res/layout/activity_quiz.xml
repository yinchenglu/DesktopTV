<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
			 android:layout_width="match_parent"
			 android:layout_height="match_parent"
			 android:background="#FF101418">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:padding="32dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/quiz_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:textColor="#FFFFB74D"
				android:textSize="22sp"
				android:textStyle="bold"/>

			<TextView
				android:id="@+id/quiz_progress"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="#FF9E9E9E"
				android:textSize="20sp"/>

			<TextView
				android:id="@+id/quiz_balance"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginLeft="20dp"
				android:textColor="#FF80CBC4"
				android:textSize="20sp"/>
		</LinearLayout>

		<TextView
			android:id="@+id/quiz_prompt"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="28dp"
			android:lineSpacingExtra="6dp"
			android:textColor="#FFFFFFFF"
			android:textSize="34sp"/>

		<LinearLayout
			android:id="@+id/quiz_options"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:orientation="vertical"/>

		<TextView
			android:id="@+id/quiz_feedback"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:lineSpacingExtra="4dp"
			android:textColor="#FFFFD54F"
			android:textSize="20sp"
			android:visibility="gone"/>

		<TextView
			android:id="@+id/quiz_hint"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:text="@string/study_hint_choose"
			android:textColor="#FF757575"
			android:textSize="16sp"/>
	</LinearLayout>

	<LinearLayout
		android:id="@+id/quiz_result_panel"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#FF101418"
		android:gravity="center"
		android:orientation="vertical"
		android:padding="48dp"
		android:visibility="gone">

		<TextView
			android:id="@+id/quiz_result_title"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textColor="#FFFFB74D"
			android:textSize="44sp"
			android:textStyle="bold"/>

		<TextView
			android:id="@+id/quiz_result_detail"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="24dp"
			android:gravity="center"
			android:lineSpacingExtra="8dp"
			android:textColor="#FFE0E0E0"
			android:textSize="24sp"/>

		<LinearLayout
			android:id="@+id/quiz_result_action"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="40dp"
			android:background="@drawable/application_selector"
			android:descendantFocusability="blocksDescendants"
			android:focusable="true"
			android:focusableInTouchMode="false"
			android:paddingLeft="36dp"
			android:paddingTop="16dp"
			android:paddingRight="36dp"
			android:paddingBottom="16dp">

			<TextView
				android:id="@+id/quiz_result_action_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/study_action_next"
				android:textColor="#FFFFFFFF"
				android:textSize="24sp"/>
		</LinearLayout>
	</LinearLayout>
</FrameLayout>
